{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "paths": {
      "@native/*": [
        "../../../saavi/apps/web/src/*"
      ],
      "@portfolio/*": [
        "../../src/*"
      ],
      "@saavi/design-system/components": [
        "../../../saavi/packages/design-system/src/components/index.ts"
      ],
      "@saavi/design-system/patterns": [
        "../../../saavi/packages/design-system/src/patterns/index.ts"
      ],
      "@saavi/i18n": [
        "../../../saavi/packages/i18n/src/index.ts"
      ],
      "@saavi/i18n/hub": [
        "../../../saavi/packages/i18n/src/hub.ts"
      ],
      "@saavi/contracts": [
        "../../../saavi/packages/contracts/src/index.ts"
      ],
      "react": [
        "../../../saavi/node_modules/@types/react"
      ],
      "react/*": [
        "../../../saavi/node_modules/@types/react/*"
      ]
    }
  },
  "include": [
    "*.tsx",
    "*.ts",
    "../../next-env.d.ts"
  ]
}
